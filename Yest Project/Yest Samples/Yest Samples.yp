  <testElements xsi:type="yest:TestOperation" id="sqxRnbeTK72Gxnh0CtfnHBsBzjz9X6ur">
    <prerequisite>
      <fragments xsi:type="yest:TextField" content="import contains a record which consists of a travel document only"/>
    </prerequisite>
    <highLevelStep>
      <action>
        <fragments xsi:type="yest:TextField" content="import contains a record which consists of a travel document only"/>
      </action>
      <expectedResult/>
    </highLevelStep>
    <lowLevelSteps>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that import file only contains a &quot;Z&quot; record for this travel document"/>
      </action>
      <expectedResult/>
    </lowLevelSteps>
  </testElements>
  <testElements xsi:type="yest:TestOperation" id="AmwrBbCxMBPRRA6Ujq0iux9toBT3snBc">
    <prerequisite>
      <fragments xsi:type="yest:TextField" content="import contains a record which consists of a travel document which includes a visa"/>
    </prerequisite>
    <highLevelStep>
      <action>
        <fragments xsi:type="yest:TextField" content="import contains a record which consists of a travel document which includes a visa"/>
      </action>
      <expectedResult/>
    </highLevelStep>
    <lowLevelSteps>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that visa record (line starts with V) directly follows the travel document record (line starts with Z)"/>
      </action>
      <expectedResult>
        <fragments xsi:type="yest:TextField" content="visa record follows travel document record"/>
      </expectedResult>
    </lowLevelSteps>
  </testElements>
  <testElements xsi:type="yest:TestOperation" id="7JH0YMlwQribjp7JEasvMVwvRbqsoKtV">
    <highLevelStep>
      <action>
        <fragments xsi:type="yest:TextField" content="record should be imported successfully"/>
      </action>
      <expectedResult/>
    </highLevelStep>
  </testElements>
  <testElements xsi:type="yest:TestOperation" id="IoxoYgB4Uls6YxTAzMO9J3EbXIHxOWbq">
    <highLevelStep>
      <action>
        <fragments xsi:type="yest:TextField" content="check error log - record should be visible in the error log with corresponding error message"/>
      </action>
      <expectedResult/>
    </highLevelStep>
    <lowLevelSteps>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that there is a corresponding error message for this record in the logfile"/>
      </action>
      <expectedResult/>
    </lowLevelSteps>
    <lowLevelSteps>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that the error is mentioned in the logfile shared via Email"/>
      </action>
      <expectedResult/>
    </lowLevelSteps>
    <lowLevelSteps>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that the import continues to process further records in the import file in case there are more data available in the file"/>
      </action>
      <expectedResult/>
    </lowLevelSteps>
  </testElements>
