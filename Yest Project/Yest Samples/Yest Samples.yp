  <testElements xsi:type="yest:TestOperation" id="svI6E2mJ1Gz4xcgSFxaiQddjQCrcA99X">
    <prerequisite>
      <fragments xsi:type="yest:TextField" content="provide a visa with an expiry date which ends at midnight (&quot;2359&quot;)"/>
    </prerequisite>
    <highLevelStep>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that the timestamp part of the visa expiry date is &quot;2359&quot;. The format of the entire string must be YYYYMMDDHHMM"/>
      </action>
      <expectedResult/>
    </highLevelStep>
    <lowLevelSteps>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that the timestamp part of the visa expiry date is &quot;2359&quot;. The format of the entire string must be YYYYMMDDHHMM"/>
      </action>
      <expectedResult/>
    </lowLevelSteps>
  </testElements>
  <testElements xsi:type="yest:TestOperation" id="zlxuhxUmhx1f87xHjLFGiXApjlB7Md0u">
    <prerequisite>
      <fragments xsi:type="yest:TextField" content="provide a visa with an expiry date where it becomes invalid during the day (e.g. &quot;0900&quot;)"/>
    </prerequisite>
    <highLevelStep>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that the provided timestamp of the visa expiry date matches with the hour at which the visa becomes invalid. Format must be YYYYMMDDHHMM"/>
      </action>
      <expectedResult/>
    </highLevelStep>
    <lowLevelSteps>
      <action>
        <fragments xsi:type="yest:TextField" content="verify that the provided timestamp of the visa expiry date matches with the hour at which the visa becomes invalid. Format must be YYYYMMDDHHMM"/>
      </action>
      <expectedResult/>
    </lowLevelSteps>
  </testElements>
